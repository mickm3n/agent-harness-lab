{
  "permissions": {
    "allow": [
      "Bash(./run-tests.sh)",
      "Bash(uv run --with ruff ruff check:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./config/production.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/run_tests_hook.sh"
          }
        ]
      }
    ]
  }
}
